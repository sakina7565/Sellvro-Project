# ==============================================================================
# Sellvro - Apache & cPanel Configuration (.htaccess)
# ==============================================================================

# Enable Phusion Passenger and friendly error reporting for troubleshooting
<IfModule mod_passenger.c>
    PassengerEnabled on
    PassengerFriendlyErrorPages on
    PassengerStartupFile app.cjs
    PassengerNodejs /usr/local/bin/node
</IfModule>

# 1. SECURITY: Block public access to sensitive files (compatible with Apache 2.2 & 2.4)
<FilesMatch "(^\.env|package(-lock)?\.json|tsconfig\.json|\.git|app\.cjs|app\.js|stderr\.log)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory browsing
Options -Indexes

# 2. SSL ENFORCEMENT: Force HTTPS — only when SSL is actually active on this server
# Remove or comment these lines if your SSL certificate is NOT yet installed
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Skip if already HTTPS
    RewriteCond %{HTTPS} off
    # Skip if the request is from Passenger's internal loopback (avoids redirect loops)
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 3. PERFORMANCE: Enable GZIP Compression for static assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# 4. BROWSER CACHING: Cache Vite static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
</IfModule>
