# ==============================================================================
# Sellvro - Environment Variables Configuration
# ==============================================================================

# Node Environment ('production' for cPanel live deployment, 'development' for local)
NODE_ENV=production

# Application Port (cPanel Passenger assigns PORT automatically; fallback is 5000)
PORT=5001

# MongoDB Atlas Connection String
# IMPORTANT: In MongoDB Atlas -> Network Access, whitelist your cPanel server's IP (or allow 0.0.0.0/0)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sellvro?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_very_long_secure_random_string_for_production
JWT_EXPIRES_IN=7d

# Allowed Client Domains (comma-separated if multiple)
CLIENT_URL=https://yourdomain.com

# SMTP Email Configuration (Optional - uses cPanel Webmail or custom SMTP for OTP verification)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your_email_password
SMTP_FROM="Sellvro" <no-reply@yourdomain.com>
# FedEx Developer REST API Live Tracking
FEDEX_API_KEY=your_fedex_client_id_api_key
FEDEX_SECRET_KEY=your_fedex_client_secret
FEDEX_ACCOUNT_NUMBER=your_fedex_account_number
FEDEX_ENV=production

# Google OAuth 2.0 Client ID (Google Identity Services)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# WMS Integration (Automated Bridge & MySQL Direct)
WMS_BASE_URL=https://wmsbysellvro.com
WMS_BRIDGE_URL=https://wmsbysellvro.com/wms_bridge.php
WMS_DB_HOST=127.0.0.1
WMS_DB_PORT=3306
WMS_DB_USER=root
WMS_DB_PASSWORD=
WMS_DB_NAME=sql_wmsbysellvro_com
